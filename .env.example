# Bu faylni .env deb nusxalab, qiymatlarni to'ldiring.
# .env fayli hech qachon GitHub'ga yuklanmasligi kerak (.gitignore ichida).

# MAJBURIY -------------------------------------------------------------
# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Admin Telegram ID lari, vergul bilan ajratiladi
ADMIN_IDS=

# IXTIYORIY -----------------------------------------------------------
# Baza saqlanadigan papka. Railway Volume ishlatilsa: /data
DB_DIR=/data

# AI chat uchun ASOSIY provayder - Google Gemini.
# https://aistudio.google.com/apikey manzilidan BEPUL olinadi.
# Buni to'ldirmasangiz "AI bilan suhbat" bo'limi ishlamaydi.
GEMINI_API_KEY=

# AI chat uchun ZAXIRA provayder - Bytez (ixtiyoriy).
# Gemini javob bermasa shundan foydalaniladi.
BYTEZ_API_KEY=

# Fon o'chirish API kaliti
REMBG_API_KEY=
